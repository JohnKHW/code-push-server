# Local file-backed Azure Storage emulation. No Azure storage account/key is needed.
NODE_ENV=development
DEPLOYMENT_ENVIRONMENT=local
EMULATED=true
API_PORT=3000
SERVER_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:4000
CUSTOM_STORAGE_URL=http://127.0.0.1:10000
HTTPS=
DEBUG_DISABLE_AUTH=false
ENABLE_ACCOUNT_REGISTRATION=true
UPLOAD_SIZE_LIMIT_MB=200

# Local Redis uses verified TLS. setup.mjs appends the generated password and CA path.
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# Add your development Entra values to .local/api.env for admin and CLI MSAL sign-in.
# Register http://localhost:4000/admin/auth as the SPA redirect URI.
# MSAL_CLIENT_ID=<SPA registration client GUID>
# MSAL_TENANT_ID=<tenant GUID>
# MSAL_API_AUDIENCE=<API registration client GUID>
# MSAL_API_SCOPE=api://<API registration client GUID>/access_as_user
# MSAL_CLI_CLIENT_ID=<public CLI client GUID; optional if SPA supports device flow>
# MSAL_REQUIRED_ROLE=<optional API user role>
